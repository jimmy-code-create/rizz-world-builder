# Public Supabase settings used by the browser app.
# Copy this file to .env for local development and add your project values.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_WORKER_URL=
VITE_VAPID_PUBLIC_KEY=
VITE_GIPHY_API_KEY=

# Optional TURN relay for voice rooms. Keep the shared secret server-side.
TURN_SERVER_URLS=
TURN_SHARED_SECRET=