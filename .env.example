# Public Supabase settings used by the browser app.
# Copy this file to .env for local development and add your project values.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_WORKER_URL=
VITE_VAPID_PUBLIC_KEY=
VITE_GIPHY_API_KEY=

# Server-side Groq chat settings.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Optional TURN relay for voice rooms. Keep the shared secret server-side.
TURN_SERVER_URLS=
TURN_SHARED_SECRET=

# Optional Hindi/Hinglish chat-story narration backend (server-side only).
# When unset, stories use free device voices for Hindi. When set, point it at
# your own self-hosted Chatterbox-Multilingual / Indic-Parler-TTS endpoint
# (see docs/chatstory-tts.md). NEVER use a VITE_ variable for the token.
CHATSTORY_TTS_URL=
CHATSTORY_TTS_MODEL=ResembleAI/chatterbox
HF_TOKEN=